---
import '@fontsource-variable/petrona';
import '@fontsource-variable/petrona/wght-italic.css';
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '../styles/global.css';
interface Props { title?: string; }
const { title = 'DuckDB Release Watch · Query.Farm' } = Astro.props;
const description = 'Keeping time with DuckDB. A live countdown to DuckDB 2.0, time since the latest release, and the remaining LTS community support window.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f3ea" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/social.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the clocks</a>
    <div class="top-rule" aria-hidden="true"></div>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="https://query.farm" aria-label="Query Farm home">
          <img src="/images/query-farm.svg" alt="" width="31" height="31" />
          <span>Query<span class="wordmark-dot">.</span>Farm</span>
        </a>
        <div class="header-divider" aria-hidden="true"></div>
        <a class="site-name" href="/">DuckDB Release Watch</a>
        <nav aria-label="Main navigation">
          <a href="/#release-ledger">Release ledger</a>
          <a href="https://duckdb.org" class="duckdb-link">DuckDB <span aria-hidden="true">↗</span></a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <a class="footer-brand" href="https://query.farm"><img src="/images/query-farm.svg" alt="" width="21" height="21" /> A small thing by <strong>Query.Farm</strong> <span aria-hidden="true">↗</span></a>
        <span>An independent clock for the DuckDB community.</span>
        <a href="#about-the-clock">About the clock <span aria-hidden="true">↑</span></a>
      </footer>
    </div>
  </body>
</html>
