---
interface Props { kind?: 'seconds' | 'support'; }
const { kind = 'seconds' } = Astro.props;
---
<svg class:list={['dial', `dial-${kind}`]} viewBox="0 0 100 100" fill="none" aria-hidden="true">
  <circle cx="50" cy="50" r="47" class="dial-outline" />
  {Array.from({ length: 60 }, (_, i) => (
    <line x1="50" y1="8" x2="50" y2={i % 5 === 0 ? 15 : 11} transform={`rotate(${i * 6} 50 50)`} class:list={['dial-tick', { major: i % 5 === 0 }]} />
  ))}
  {kind === 'seconds' ? (
    <>
      <path d="M50 50L32 32M50 50L67 35" class="dial-hands" />
      <g data-second-hand><path d="M50 59V18" class="dial-second" /><circle cx="50" cy="50" r="3" class="dial-pin" /></g>
    </>
  ) : (
    <>
      <circle cx="50" cy="50" r="29" class="dial-track" />
      <circle cx="50" cy="50" r="29" pathLength="100" class="dial-progress" data-support-ring transform="rotate(-90 50 50)" />
      <text x="50" y="53" text-anchor="middle" class="dial-label">LTS</text>
    </>
  )}
</svg>
