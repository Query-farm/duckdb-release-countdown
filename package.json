{
  "name": "duckdb-release-clock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "refresh": "node --import tsx scripts/refresh-calendar.ts",
    "prebuild": "npm run refresh",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "preview:cloudflare": "wrangler dev",
    "check": "astro check && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "generate:social": "node --import tsx scripts/generate-social.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/petrona": "^5.2.8",
    "astro": "^7.3.7",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
